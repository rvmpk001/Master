{
  "servers": {
    "windows-ui-inspector": {
      "type": "stdio",
      "command": "${workspaceFolder}/tools/windows-ui-inspector/.venv/Scripts/python.exe",
      "args": ["server.py"],
      "cwd": "${workspaceFolder}/tools/windows-ui-inspector",
      "env": {
        "PYTHONUTF8": "1",
        "WINDOWS_INSPECTOR_WORKSPACE": "${workspaceFolder}"
      }
    }
  }
}
