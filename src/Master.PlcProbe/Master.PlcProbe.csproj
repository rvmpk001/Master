<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Unitronics.ComDriver">
      <HintPath>..\Master.WinUI\Drivers\Unitronics.ComDriver.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Unitronics.ComDriver.Security">
      <HintPath>..\Master.WinUI\Drivers\Unitronics.ComDriver.Security.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
