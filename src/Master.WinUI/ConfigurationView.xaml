<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Master_WinUI.ConfigurationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="AccessTreeItemTemplate">
            <CheckBox
                Content="{Binding Content.Title}"
                IsChecked="{Binding Content.IsEnabled, Mode=TwoWay}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowSpacing="8" Background="{ThemeResource Palette111C2D}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="12,8" Background="{ThemeResource Palette172337}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Configuración" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Parámetros de planta, remisiones y operación" Foreground="{ThemeResource PaletteA9B8CC}" FontSize="12" />
            </StackPanel>
            <Button x:Name="SaveButton" Grid.Column="1" Content="Guardar" Click="Save_Click" Margin="4,0" />
            <Button
                Grid.Column="2"
                Click="Close_Click"
                Width="36"
                Height="36"
                Padding="0"
                Margin="4,0"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Cerrar configuración"
                AutomationProperties.Name="Cerrar configuración">
                <SymbolIcon Symbol="Cancel" />
            </Button>
        </Grid>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" />
        <TabView x:Name="ConfigurationTabs" Grid.Row="2" IsAddTabButtonVisible="False" CanReorderTabs="False" TabWidthMode="Equal">
            <TabViewItem Header="Configuración de la máquina" />
            <TabViewItem Header="Configuración PLC" />
            <TabViewItem Header="Datos generales de la Cía." />
            <TabViewItem Header="Ajuste de Remisión" />
            <TabViewItem Header="Imágenes On" />
            <TabViewItem Header="Imágenes Off" />
            <TabViewItem Header="TamañoImagen" />
            <TabViewItem Header="Mensajes" />
            <TabViewItem Header="Adicionales" />
            <TabViewItem Header="Pedidos" />
            <TabViewItem Header="Accesos" />
        </TabView>
        <ContentControl
            x:Name="PlcContentHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <ContentControl
            x:Name="CompanyContentHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <ContentControl
            x:Name="RemissionContentHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <ContentControl
            x:Name="ImagesOnContentHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <ContentControl
            x:Name="ImagesOffContentHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <ContentControl
            x:Name="ImageSizesContentHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <ContentControl
            x:Name="MessagesContentHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <ContentControl
            x:Name="AdditionalContentHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <ContentControl
            x:Name="OrdersContentHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <ContentControl
            x:Name="AccessContentHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
