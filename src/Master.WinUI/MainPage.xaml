                        <Button x:Name="OrderEditorSaveButton" Content="Guardar" Click="SaveOrder_Click" Style="{StaticResource DefaultButtonStyle}" />
                    </StackPanel>
                    <Border Grid.Row="2" Background="#172337" BorderBrush="#40516A" BorderThickness="0,0,0,1" Padding="10,5">
                        <TextBlock Text="Información de Pedido" Foreground="#F1F5F9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <ScrollViewer Grid.Row="3" Padding="14" VerticalScrollBarVisibility="Auto">
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Fecha:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <DatePicker x:Name="OrderDatePicker" Grid.Column="1" Grid.ColumnSpan="3" Width="390" HorizontalAlignment="Left" IsEnabled="False" />
                            <TextBlock Grid.Row="1" Text="Cliente:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:Name="OrderClientComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" ItemsSource="{x:Bind OrderClients}" DisplayMemberPath="Client" SelectionChanged="OrderClientComboBox_SelectionChanged" />
                            <TextBlock Grid.Row="2" Text="Obra:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:Name="OrderConstructionComboBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" IsEditable="True" />
                            <TextBlock Grid.Row="3" Text="Pedido por:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBox x:Name="OrderRequestedByTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" IsReadOnly="True" />
                            <TextBlock Grid.Row="4" Text="Autoriza Pedido:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBox x:Name="OrderAuthorizedByTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" />
                            <TextBlock Grid.Row="5" Text="Teléfono:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBox x:Name="OrderPhoneTextBox" Grid.Row="5" Grid.Column="1" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Email:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBox x:Name="OrderEmailTextBox" Grid.Row="5" Grid.Column="3" />
                            <TextBlock Grid.Row="6" Text="Fecha Entrega:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <DatePicker x:Name="OrderDeliveryDatePicker" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Width="390" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="7" Text="Hora:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TimePicker x:Name="OrderDeliveryTimePicker" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Text="Cantidad:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="7" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="OrderQuantityTextBox" Width="120" Text="0.00" InputScope="Number" />
                                <TextBlock Text="M³" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="8" Text="Receta:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:Name="OrderRecipeComboBox" Grid.Row="8" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind OrderRecipes}" DisplayMemberPath="Code" SelectionChanged="OrderRecipeComboBox_SelectionChanged" />
                            <TextBlock Grid.Row="8" Grid.Column="2" Text="Descripción:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBox x:Name="OrderDescriptionTextBox" Grid.Row="8" Grid.Column="3" HorizontalAlignment="Stretch" IsReadOnly="True" />
                            <TextBlock Grid.Row="9" Text="Tipo descarga:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:Name="OrderDischargeTypeComboBox" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" ItemsSource="{x:Bind OrderDischargeTypes}" />
                            <TextBlock Grid.Row="10" Text="Envío:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="OrderShippingTextBox" Width="120" Text="0.00" InputScope="Number" />
                                <TextBlock Text="M³" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="10" Grid.Column="2" Text="Intervalo:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <NumberBox x:Name="OrderIntervalNumberBox" Grid.Row="10" Grid.Column="3" HorizontalAlignment="Stretch" Value="41" Minimum="0" SpinButtonPlacementMode="Inline" />
                            <TextBlock Grid.Row="11" Text="Producto:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:Name="OrderProductComboBox" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" ItemsSource="{x:Bind OrderProducts}" />
                            <TextBlock Grid.Row="12" Text="Condiciones pago:" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:Name="OrderPaymentConditionsComboBox" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" ItemsSource="{x:Bind OrderPaymentConditions}" />
                            <TextBlock Grid.Row="13" Text="Observaciones:" VerticalAlignment="Top" TextWrapping="Wrap" />
                            <TextBox x:Name="OrderObservationsTextBox" Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                            <TextBlock Grid.Row="14" Grid.Column="2" Text="Pedido" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBox x:Name="OrderNumberTextBox" Grid.Row="14" Grid.Column="3" HorizontalAlignment="Stretch" IsReadOnly="True" />
                        </Grid>
                    </ScrollViewer>
                    <TextBlock x:Name="OrderEditorStatusText" Grid.Row="4" Margin="12,0,12,8" Foreground="#A9B8CC" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="ManualLoadOverlay" Grid.RowSpan="4" Background="#99000000" Visibility="Collapsed">
            <Border MaxWidth="1200" MaxHeight="850" Margin="12" Background="#111C2D" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#0078D4" CornerRadius="5,5,0,0" Padding="12,2">
                        <TextBlock Text="Carga Manual" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                        <Button Content="×" Click="CloseManualLoad_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="28" Padding="0" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" ToolTipService.ToolTip="Cerrar Carga Manual" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#172337" Padding="8,5" Spacing="8">
                        <Button x:Name="ManualLoadSaveButton" Content="Guardar" Click="SaveManualLoad_Click" Style="{StaticResource DefaultButtonStyle}" />
                    </StackPanel>
                    <TabView Grid.Row="2" IsAddTabButtonVisible="False" CanReorderTabs="False" Background="#101B2D">
                        <TabViewItem Header="Materiales">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Padding="16" RowSpacing="12" ColumnSpacing="14" Background="#101B2D">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CÓDIGO DE RECETA:" VerticalAlignment="Center" Foreground="#E6EDF7" />
                                        <ComboBox x:Name="ManualLoadRecipeComboBox" Grid.Column="1" IsEditable="True" PlaceholderText="Selecciona o escribe receta" ItemsSource="{x:Bind ManualLoadRecipes}" DisplayMemberPath="Code" SelectionChanged="ManualLoadRecipe_SelectionChanged" Foreground="#F1F5F9" Background="#111B2B" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DESCRIPCIÓN DE LA FÓRMULA:" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#E6EDF7" />
                                        <TextBox x:Name="ManualLoadDescriptionTextBox" Grid.Column="1" Foreground="#F1F5F9" Background="#111B2B" />
                                    </Grid>
                                    <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CANTIDAD:" VerticalAlignment="Center" Foreground="#E6EDF7" />
                                        <NumberBox x:Name="ManualLoadQuantityNumberBox" Grid.Column="1" Value="0" Minimum="0" Foreground="#F1F5F9" Background="#111B2B" />
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="PEDIDO:" VerticalAlignment="Center" Foreground="#E6EDF7" />
                                        <ComboBox x:Name="ManualLoadOrderComboBox" Grid.Column="1" PlaceholderText="Selecciona pedido" ItemsSource="{x:Bind ManualLoadOrderNumbers}" SelectedIndex="0" SelectionChanged="ManualLoadOrder_SelectionChanged" Foreground="#F1F5F9" Background="#111B2B" />
                                    </Grid>
                                    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#40516A" BorderThickness="1" Padding="10" Background="#172337">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="8">
                                                <TextBox x:Name="ManualLoadA1TextBox" Header="CANTIDAD GRAVA *" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadA2TextBox" Header="CANTIDAD ARENA *" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadA3TextBox" Header="CANTIDAD AGREGADO 3" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadA4TextBox" Header="CANTIDAD AGREGADO 4" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadA5TextBox" Header="CANTIDAD AGREGADO 5" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadA6TextBox" Header="CANTIDAD AGREGADO 6" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadA7TextBox" Header="CANTIDAD AGREGADO 7" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadA8TextBox" Header="CANTIDAD AGREGADO 8" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <TextBox x:Name="ManualLoadC1TextBox" Header="CANTIDAD CEMENTO *" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadC2TextBox" Header="CANTIDAD CEMENTO 2" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadC3TextBox" Header="CANTIDAD CEMENTO 3" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadC4TextBox" Header="CANTIDAD CEMENTO 4" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadC5TextBox" Header="CANTIDAD CEMENTO 5" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadWater1TextBox" Header="CANTIDAD AGUA 1 *" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadWater2TextBox" Header="CANTIDAD AGUA 2" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadWater3TextBox" Header="CANTIDAD AGUA 3" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="8">
                                                <TextBox x:Name="ManualLoadD1TextBox" Header="CANTIDAD ADITIVO 1 *" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadD2TextBox" Header="CANTIDAD ADITIVO 2 *" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadD3TextBox" Header="CANTIDAD ADITIVO 3" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadD4TextBox" Header="CANTIDAD ADITIVO 4" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadD5TextBox" Header="CANTIDAD ADITIVO 5" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadD6TextBox" Header="CANTIDAD ADITIVO 6" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadFI1TextBox" Header="CANTIDAD FIBRA 1" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadFI2TextBox" Header="CANTIDAD FIBRA 2" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                                <TextBox x:Name="ManualLoadFI3TextBox" Header="CANTIDAD FIBRA 3" Text="0" Foreground="#F1F5F9" Background="#111B2B" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="ManualLoadStatusText" Grid.Row="3" Grid.ColumnSpan="2" Foreground="#A9B8CC" TextWrapping="Wrap" />
                                </Grid>
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem Header="Datos Remisión">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Padding="16" ColumnSpacing="12" RowSpacing="12" Background="#101B2D">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="#40516A" BorderThickness="1" Padding="10" Background="#172337">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="DATOS DE REMISIÓN" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                            <ComboBox x:Name="ManualLoadRemissionOrderComboBox" Header="PEDIDO" ItemsSource="{x:Bind ManualLoadOrderNumbers}" SelectionChanged="ManualLoadRemissionOrder_SelectionChanged" PlaceholderText="Selecciona pedido activo" Foreground="#F1F5F9" Background="#111B2B" />
                                            <ComboBox x:Name="ManualLoadRemissionClientComboBox" Header="CLIENTE" ItemsSource="{x:Bind OrderClients}" DisplayMemberPath="Client" IsEditable="True" PlaceholderText="Selecciona cliente" Foreground="#F1F5F9" Background="#111B2B" />
                                            <ComboBox x:Name="ManualLoadRemissionConstructionComboBox" Header="OBRA" ItemsSource="{x:Bind ManualLoadConstructionOptions}" IsEditable="True" PlaceholderText="Selecciona obra" Foreground="#F1F5F9" Background="#111B2B" />
                                            <ComboBox x:Name="ManualLoadRemissionOperatorComboBox" Header="OPERADOR" ItemsSource="{x:Bind ManualLoadOperators}" DisplayMemberPath="Name" PlaceholderText="Selecciona operador" Foreground="#F1F5F9" Background="#111B2B" />
                                            <TextBox x:Name="ManualLoadRemissionStatusTextBox" Header="ESTATUS" IsReadOnly="True" Foreground="#F1F5F9" Background="#111B2B" />
                                            <ComboBox x:Name="ManualLoadRemissionProductComboBox" Header="PRODUCTO" ItemsSource="{x:Bind OrderProducts}" IsEditable="True" PlaceholderText="Selecciona producto" Foreground="#F1F5F9" Background="#111B2B" />
                                            <ComboBox x:Name="ManualLoadRemissionPaymentComboBox" Header="CONDICIONES PAGO" ItemsSource="{x:Bind OrderPaymentConditions}" IsEditable="True" PlaceholderText="Selecciona condiciones" Foreground="#F1F5F9" Background="#111B2B" />
                                            <ComboBox x:Name="ManualLoadRemissionDischargeComboBox" Header="TIPO DESCARGA" ItemsSource="{x:Bind OrderDischargeTypes}" IsEditable="True" PlaceholderText="Selecciona tipo" Foreground="#F1F5F9" Background="#111B2B" />
                                            <TextBox Header="DESPACHADOR" Text="1" Foreground="#F1F5F9" Background="#111B2B" />
                                            <TextBox x:Name="ManualLoadRemissionTextBox" Header="REMISIÓN" MaxLength="50" IsReadOnly="True" Foreground="#F1F5F9" Background="#111B2B" />
                                            <ComboBox x:Name="ManualLoadRemissionTruckComboBox" Header="CAMIÓN" ItemsSource="{x:Bind ManualLoadTrucks}" DisplayMemberPath="Unit" PlaceholderText="Selecciona camión" Foreground="#F1F5F9" Background="#111B2B" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="#40516A" BorderThickness="1" Padding="10" Background="#172337">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="ESTATUS" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                            <NumberBox x:Name="ManualLoadOrderedQuantityNumberBox" Header="PEDIDOS (M³)" Value="0" Minimum="0" Foreground="#F1F5F9" Background="#111B2B" />
                                            <NumberBox x:Name="ManualLoadSuppliedQuantityNumberBox" Header="SURTIDOS (M³)" Value="0" Minimum="0" Foreground="#F1F5F9" Background="#111B2B" />
                                            <NumberBox x:Name="ManualLoadToSupplyQuantityNumberBox" Header="X SURTIR (M³)" Value="0" Minimum="0" Foreground="#F1F5F9" Background="#111B2B" />
                                            <TextBox x:Name="ManualLoadRemissionObservationsTextBox" Header="OBSERVACIONES" AcceptsReturn="True" Height="90" TextWrapping="Wrap" Foreground="#F1F5F9" Background="#111B2B" />
                                            <DatePicker Header="FECHA REMISIÓN REAL" Foreground="#F1F5F9" />
                                            <TimePicker Header="HORA REMISIÓN REAL" Foreground="#F1F5F9" />
                                            <ComboBox Header="TURNO" PlaceholderText="Selecciona turno" Foreground="#F1F5F9" Background="#111B2B" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>
        </Grid>

        <Grid x:Name="LoginShell" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" MaxWidth="520" Padding="24">
            <Border Background="#111C2D" BorderBrush="#40516A" BorderThickness="1" CornerRadius="12" Padding="28">
                <StackPanel Spacing="14">
                    <TextBlock Text="SISTEMA BLAPACI" FontSize="26" FontWeight="Bold" Foreground="#E6EDF7" />
                    <TextBox x:Name="UsernameTextBox" Header="Usuario" MaxLength="15" Foreground="#F1F5F9" />
                    <PasswordBox x:Name="PasswordInput" Header="Contraseña" MaxLength="15" Foreground="#F1F5F9" />
                    <TextBlock x:Name="LoginErrorText" Visibility="Collapsed" Foreground="#FF8A80" TextWrapping="WrapWholeWords" />
                    <ProgressRing x:Name="LoginProgress" IsActive="False" Visibility="Collapsed" Width="28" Height="28" HorizontalAlignment="Center" />
                    <Button x:Name="LoginButton" Content="Ingresar" Click="LoginButton_Click" HorizontalAlignment="Stretch" Padding="12,10" Style="{StaticResource DefaultButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
