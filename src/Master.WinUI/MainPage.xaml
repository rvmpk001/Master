<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Master_WinUI.MainPage"
    RequestedTheme="Dark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Master_WinUI"
    xmlns:services="using:Master_WinUI.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource PaletteE6EDF7}" />
        </Style>
        <Style x:Key="DefaultButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource Palette26364D}" />
            <Setter Property="Foreground" Value="{ThemeResource PaletteF1F5F9}" />
            <Setter Property="BorderBrush" Value="{ThemeResource Palette465A75}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid x:Name="MainPageRoot" Background="{ThemeResource Palette0B1220}" SizeChanged="Page_SizeChanged" KeyDown="MainPage_KeyDown">
        <Grid x:Name="DashboardShell" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="60" Background="{ThemeResource Palette111C2D}" Padding="12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="48" Height="42" Background="{ThemeResource Palette0057A8}" CornerRadius="4">
                    <TextBlock Text="BL" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SISTEMA BLAPACI" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource PaletteF1F5F9}" />
                    <TextBlock Text="CONTROL DE PLANTA" FontSize="10" Foreground="{ThemeResource PaletteA9B8CC}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="PlantNameTextBlock" Grid.Column="1" Text="Cargando planta..." FontSize="16" FontWeight="Bold" Foreground="{ThemeResource PaletteE6EDF7}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="MachineNameTextBlock" Grid.Column="2" Text="Cargando máquina..." FontSize="16" FontWeight="Bold" Foreground="{ThemeResource PaletteE6EDF7}" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
        </Grid>

        <MenuBar x:Name="MainMenuBar" Grid.Row="1" Background="{ThemeResource Palette101B2D}">
            <MenuBarItem Title="Reportes">
                <MenuFlyoutItem Text="Centro de reportes" Tag="ReportCenter" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Existencias">
                <MenuFlyoutItem Text="Entradas" Tag="Entradas" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Salidas" Tag="Salidas" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Fórmulas">
                <MenuFlyoutItem Text="Abrir" Tag="Fórmulas" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Proveedores">
                <MenuFlyoutItem Text="Abrir" Tag="Proveedores" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Clientes">
                <MenuFlyoutItem Text="Abrir" Tag="Clientes" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Camiones">
                <MenuFlyoutItem Text="Abrir" Tag="Camiones" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Pedidos">
                <MenuFlyoutItem Text="Abrir" Tag="Pedidos" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Carga Manual">
                <MenuFlyoutItem x:Name="ManualLoadMenuItem" Text="Abrir" Tag="Carga Manual" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Configuración">
                <MenuFlyoutItem Text="Configuración de la máquina" Tag="Config:Machine" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Configuración PLC" Tag="Config:PLC" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Datos generales de la Cía." Tag="Config:Company" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Ajuste de Remisión" Tag="Config:Remission" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Imágenes On" Tag="Config:ImagesOn" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Imágenes Off" Tag="Config:ImagesOff" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Tamaño Imagen" Tag="Config:ImageSize" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Mensajes" Tag="Config:Messages" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Adicionales" Tag="Config:Additional" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Pedidos" Tag="Config:Orders" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Accesos" Tag="Config:Access" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Seguridad">
                <MenuFlyoutItem x:Name="SecurityMenuItem" Text="Abrir" Tag="Seguridad" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Ver">
                <MenuFlyoutSubItem Text="Tema">
                    <RadioMenuFlyoutItem x:Name="DarkThemeMenuItem" Text="Modo oscuro" GroupName="ApplicationTheme" IsChecked="True" Click="ThemeMenuItem_Click" />
                    <RadioMenuFlyoutItem x:Name="LightThemeMenuItem" Text="Modo claro" GroupName="ApplicationTheme" Click="ThemeMenuItem_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem Text="Lienzo de diseño" Tag="DesignPanel" IsChecked="True" Click="ViewPanel_Toggled" />
                <ToggleMenuFlyoutItem Text="Estado del panel" Tag="StatusPanel" IsChecked="True" Click="ViewPanel_Toggled" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem Text="Paneles inferiores" Tag="DashboardPanelsScrollViewer" IsChecked="True" Click="ViewPanel_Toggled" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem Text="Acciones y Controles" Tag="PlantToolsPanel" IsChecked="True" Click="ViewPanel_Toggled" />
            </MenuBarItem>
        </MenuBar>

        <Grid x:Name="DashboardContentGrid" Grid.Row="2" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PlantToolsResizeColumn" Width="8" />
                <ColumnDefinition x:Name="PlantActionColumn" Width="240" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="MainWorkspacePanel" Grid.Column="0" Padding="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid MinHeight="240">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="DesignPanel" Background="{ThemeResource Palette101B2D}" BorderBrush="{ThemeResource Palette40516A}" BorderThickness="1">
                        <Grid x:Name="DesignSurface" Background="{ThemeResource Palette1A2638}" AllowDrop="True" DragOver="DesignSurface_DragOver" Drop="DesignSurface_Drop" PointerPressed="DesignSurface_PointerPressed">
                            <Image x:Name="TemplateImage" Stretch="Uniform" IsHitTestVisible="False" />
                            <Canvas x:Name="DesignCanvas" Background="Transparent" SizeChanged="DesignCanvas_SizeChanged" />

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="CanvasResetButton" Content="Restablecer" Height="40" Padding="12,0" Click="CanvasResetButton_Click" ToolTipService.ToolTip="Vaciar el lienzo" />
                                <Button x:Name="CanvasLockButton" Width="40" Height="40" Padding="0" Click="CanvasLockButton_Click" ToolTipService.ToolTip="Desbloquear lienzo">
                                    <FontIcon x:Name="CanvasLockIcon" Glyph="&#xE785;" FontFamily="Segoe MDL2 Assets" />
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="EmptyCanvasPrompt" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="Lienzo de diseño" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Carga una imagen de la máquina como plantilla o arrástrala aquí." Foreground="{ThemeResource PaletteA9B8CC}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                <Button Content="Cargar imagen" Click="LoadTemplateImage_Click" HorizontalAlignment="Center" Padding="12,6" Style="{StaticResource DefaultButtonStyle}" />
                            </StackPanel>

                            <TextBlock Text="Lienzo preparado para agregar controles" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" FontSize="11" Foreground="{ThemeResource PaletteE6EDF7}" />
                        </Grid>
                    </Border>

                    <Border x:Name="StatusPanel" Grid.Row="1" Background="{ThemeResource Palette332B18}" BorderBrush="{ThemeResource Palette8F6C25}" BorderThickness="1" Padding="10,6" CornerRadius="4" Margin="0,6,0,0">
                        <TextBlock x:Name="ModuleStatusText" Text="Panel principal de planta. Las acciones de producción requieren una integración autorizada." TextWrapping="WrapWholeWords" FontSize="12" Foreground="{ThemeResource PaletteFFE08A}" />
                    </Border>
                </Grid>

                <Border x:Name="DashboardPanelsResizeHandle" Grid.Row="1" Height="8" Background="{ThemeResource Palette26364D}" CornerRadius="3" ToolTipService.ToolTip="Arrastra para cambiar la altura de los paneles inferiores." PointerPressed="DashboardPanelsResizeHandle_PointerPressed" PointerMoved="DashboardPanelsResizeHandle_PointerMoved" PointerReleased="DashboardPanelsResizeHandle_PointerReleased" PointerCaptureLost="DashboardPanelsResizeHandle_PointerCaptureLost">
                    <Border Width="52" Height="3" Background="{ThemeResource Palette8293AA}" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <ScrollViewer x:Name="DashboardPanelsScrollViewer" Grid.Row="2" Height="200" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="DashboardPanelsScrollViewer_SizeChanged">
                    <Grid x:Name="DashboardPanelsGrid" Width="1520" Height="200" MinWidth="1520" ColumnSpacing="8" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="360" />
                            <ColumnDefinition Width="1*" MinWidth="360" />
                            <ColumnDefinition x:Name="HumidityPanelColumn" Width="0" MinWidth="0" />
                            <ColumnDefinition x:Name="AbsorptionPanelColumn" Width="0" MinWidth="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Expander x:Name="MaterialsPanel" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" MinWidth="360" Header="Materiales" IsExpanded="False" Background="{ThemeResource Palette172337}" Foreground="{ThemeResource PaletteE6EDF7}">
                            <Grid RowSpacing="4" HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Background="{ThemeResource Palette263B5A}" Padding="4" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="75" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Material" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="Cantidad" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="Material" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="11" />
                                    <TextBlock Grid.Column="3" Text="Cantidad" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="11" />
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind MaterialRowPairs}" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:MaterialRowPair">
                                            <Grid Background="{ThemeResource Palette1E2D43}" BorderBrush="{ThemeResource Palette3B4A60}" BorderThickness="0,0,0,1" Padding="4,5" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid ColumnSpacing="4" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="75" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind First.Nombre}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind First.Cantidad}" FontSize="11" />
                                                </Grid>
                                                <Grid Grid.Column="1" ColumnSpacing="4" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="75" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Second.Nombre}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Second.Cantidad}" FontSize="11" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Expander>

                        <Expander x:Name="RemissionPanel" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" MinWidth="360" Header="Datos de Remisión" IsExpanded="False" Background="{ThemeResource Palette172337}" Foreground="{ThemeResource PaletteE6EDF7}">
                            <Grid RowSpacing="4" HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Background="{ThemeResource Palette263B5A}" Padding="4" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="4" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Título" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="Descripción" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnSpacing="4" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Título" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="Descripción" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                    </Grid>
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind RemissionRowPairs}" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:RemissionFieldPair">
                                            <Grid Background="{ThemeResource Palette1E2D43}" BorderBrush="{ThemeResource Palette3B4A60}" BorderThickness="0,0,0,1" Padding="4,3" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid ColumnSpacing="4" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind First.Titulo}" FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{x:Bind First.Valor, Mode=TwoWay}" MinHeight="26" Padding="3,2" FontSize="10" Foreground="{ThemeResource PaletteF1F5F9}" Background="{ThemeResource Palette111B2B}" IsEnabled="{x:Bind First.Editable}" />
                                                </Grid>
                                                <Grid Grid.Column="1" ColumnSpacing="4" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Second.Titulo}" FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{x:Bind Second.Valor, Mode=TwoWay}" MinHeight="26" Padding="3,2" FontSize="10" Foreground="{ThemeResource PaletteF1F5F9}" Background="{ThemeResource Palette111B2B}" IsEnabled="{x:Bind Second.Editable}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Expander>

                        <Expander x:Name="HumidityPanel" Grid.Row="0" Grid.Column="2" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" MinWidth="360" Header="Ajuste de Humedad" IsExpanded="False" Background="{ThemeResource Palette172337}" Foreground="{ThemeResource PaletteE6EDF7}">
                            <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                <Grid Background="{ThemeResource Palette263B5A}" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Agregados" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="%" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                    <TextBlock Grid.Column="2" Text="Agregados" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                    <TextBlock Grid.Column="3" Text="%" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind HumidityRowPairs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:PlantValuePair">
                                            <Grid Background="{ThemeResource Palette1E2D43}" BorderBrush="{ThemeResource Palette3B4A60}" BorderThickness="0,0,0,1" Padding="4,3" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid ColumnSpacing="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="56" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind First.Nombre}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{x:Bind First.Valor, Mode=TwoWay}" Width="56" MinWidth="56" MinHeight="24" Padding="3,0" FontSize="10" TextAlignment="Center" InputScope="Number" AutomationProperties.Name="{x:Bind First.Nombre}" />
                                                </Grid>
                                                <Grid Grid.Column="1" ColumnSpacing="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="56" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Second.Nombre}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{x:Bind Second.Valor, Mode=TwoWay}" Width="56" MinWidth="56" MinHeight="24" Padding="3,0" FontSize="10" TextAlignment="Center" InputScope="Number" AutomationProperties.Name="{x:Bind Second.Nombre}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="HumiditySaveButton" Content="Guardar" Tag="H" Click="SaveDashboardAdjustment_Click" Width="100" Height="36" MinHeight="36" Padding="12,4" HorizontalAlignment="Center" FontSize="11" Style="{StaticResource DefaultButtonStyle}" />
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="AbsorptionPanel" Grid.Row="0" Grid.Column="3" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" MinWidth="360" Header="Ajuste de Absorción" IsExpanded="False" Background="{ThemeResource Palette172337}" Foreground="{ThemeResource PaletteE6EDF7}">
                            <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                <Grid Background="{ThemeResource Palette263B5A}" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Agregados" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="%" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                    <TextBlock Grid.Column="2" Text="Agregados" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                    <TextBlock Grid.Column="3" Text="%" Foreground="{ThemeResource PaletteF1F5F9}" FontSize="10" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind AbsorptionRowPairs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:PlantValuePair">
                                            <Grid Background="{ThemeResource Palette1E2D43}" BorderBrush="{ThemeResource Palette3B4A60}" BorderThickness="0,0,0,1" Padding="4,3" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid ColumnSpacing="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="56" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind First.Nombre}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{x:Bind First.Valor, Mode=TwoWay}" Width="56" MinWidth="56" MinHeight="24" Padding="3,0" FontSize="10" TextAlignment="Center" InputScope="Number" AutomationProperties.Name="{x:Bind First.Nombre}" />
                                                </Grid>
                                                <Grid Grid.Column="1" ColumnSpacing="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="56" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Second.Nombre}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{x:Bind Second.Valor, Mode=TwoWay}" Width="56" MinWidth="56" MinHeight="24" Padding="3,0" FontSize="10" TextAlignment="Center" InputScope="Number" AutomationProperties.Name="{x:Bind Second.Nombre}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AbsorptionSaveButton" Content="Guardar" Tag="O" Click="SaveDashboardAdjustment_Click" Width="100" Height="36" MinHeight="36" Padding="12,4" HorizontalAlignment="Center" FontSize="11" Style="{StaticResource DefaultButtonStyle}" />
                            </StackPanel>
                        </Expander>

                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border x:Name="PlantToolsResizeHandle" Grid.Column="1" Width="8" Background="{ThemeResource Palette26364D}" ToolTipService.ToolTip="Arrastra para cambiar el ancho de Acciones y Controles." PointerPressed="PlantToolsResizeHandle_PointerPressed" PointerMoved="PlantToolsResizeHandle_PointerMoved" PointerReleased="PlantToolsResizeHandle_PointerReleased" PointerCaptureLost="PlantToolsResizeHandle_PointerCaptureLost">
                <Border Width="3" Height="52" Background="{ThemeResource Palette8293AA}" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TabView x:Name="PlantToolsPanel" Grid.Column="2" IsAddTabButtonVisible="False" CanReorderTabs="False" Background="{ThemeResource Palette101B2D}" SelectionChanged="PlantToolsPanel_SelectionChanged">
                <TabViewItem Header="Acciones" IsClosable="False">
                    <StackPanel Padding="8" Spacing="8" HorizontalAlignment="Stretch">
                        <Button x:Name="ProgramActionButton" Content="Programar" Click="ProgramAction_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Prepara la remisión. No guarda datos ni envía órdenes al PLC." Style="{StaticResource DefaultButtonStyle}" />
                        <Button x:Name="LoadActionButton" Content="Cargar" Click="SimulatedLoad_Click" HorizontalAlignment="Stretch" IsEnabled="False" ToolTipService.ToolTip="Continúa el flujo simulado de la remisión." Style="{StaticResource DefaultButtonStyle}" />
                        <Button x:Name="DownloadActionButton" Content="Descargar" Click="SimulatedDownload_Click" HorizontalAlignment="Stretch" Visibility="Collapsed" IsEnabled="False" ToolTipService.ToolTip="Simula la descarga según las cantidades de la receta y genera el PDF." Style="{StaticResource DefaultButtonStyle}" />
                        <Button x:Name="PauseActionButton" Content="Pausar" Click="SimulatedPause_Click" HorizontalAlignment="Stretch" IsEnabled="False" ToolTipService.ToolTip="Pausa o reanuda el flujo de la remisión." Style="{StaticResource DefaultButtonStyle}" />
                        <Button x:Name="CancelActionButton" Content="Cancelar" Click="SimulatedCancel_Click" HorizontalAlignment="Stretch" IsEnabled="False" ToolTipService.ToolTip="Cancela el flujo actual. No guarda datos ni envía órdenes al PLC." Style="{StaticResource DefaultButtonStyle}" />
                    </StackPanel>
                </TabViewItem>
                <TabViewItem Header="Controles" IsClosable="False">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
