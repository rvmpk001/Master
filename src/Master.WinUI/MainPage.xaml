<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Master_WinUI.MainPage"
    RequestedTheme="Dark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Master_WinUI"
    xmlns:services="using:Master_WinUI.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF7" />
        </Style>
        <Style x:Key="DefaultButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#26364D" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#465A75" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid Background="#0B1220" SizeChanged="Page_SizeChanged">
        <Grid x:Name="DashboardShell" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="60" Background="#111C2D" Padding="12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="48" Height="42" Background="#0057A8" CornerRadius="4">
                    <TextBlock Text="BL" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SISTEMA BLAPACI" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" />
                    <TextBlock Text="CONTROL DE PLANTA" FontSize="10" Foreground="#A9B8CC" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="PlantNameTextBlock" Grid.Column="1" Text="Cargando planta..." FontSize="16" FontWeight="Bold" Foreground="#E6EDF7" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <MenuBar Grid.Row="1" Background="#101B2D">
            <MenuBarItem Title="Reportes">
                <MenuFlyoutItem Text="Reporte de producción general" Tag="Reporte de producción general" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Reporte de producción real" Tag="Reporte de producción real" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Reporte de entradas de material" Tag="Reporte de entradas de material" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Reporte de salidas de material" Tag="Reporte de salidas de material" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Reporte de existencias" Tag="Reporte de existencias" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Reporte general de fórmulas" Tag="Reporte general de fórmulas" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Reporte general de clientes" Tag="Reporte general de clientes" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Reporte general de proveedor" Tag="Reporte general de proveedor" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Remisión anterior" Tag="Remisión anterior" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Remisión de salida" Tag="Remisión de salida" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Reporte de pedidos" Tag="Reporte de pedidos" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Relación de producción" Tag="Relación de producción" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Existencias">
                <MenuFlyoutItem Text="Entradas" Tag="Entradas" Click="ModuleNavigation_Click" />
                <MenuFlyoutItem Text="Salidas" Tag="Salidas" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Fórmulas">
                <MenuFlyoutItem Text="Abrir" Tag="Fórmulas" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Proveedores">
                <MenuFlyoutItem Text="Abrir" Tag="Proveedores" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Clientes">
                <MenuFlyoutItem Text="Abrir" Tag="Clientes" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Camiones">
                <MenuFlyoutItem Text="Abrir" Tag="Camiones" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Pedidos">
                <MenuFlyoutItem Text="Abrir" Tag="Pedidos" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Carga Manual">
                <MenuFlyoutItem Text="Abrir" Tag="Carga Manual" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Configuración">
                <MenuFlyoutItem Text="Abrir" Tag="Configuración" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Seguridad">
                <MenuFlyoutItem Text="Abrir" Tag="Seguridad" Click="ModuleNavigation_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Ver">
                <ToggleMenuFlyoutItem Text="Lienzo de diseño" Tag="DesignPanel" IsChecked="True" Click="ViewPanel_Toggled" />
                <ToggleMenuFlyoutItem Text="Estado del panel" Tag="StatusPanel" IsChecked="True" Click="ViewPanel_Toggled" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem Text="Paneles inferiores" Tag="DashboardPanelsScrollViewer" IsChecked="True" Click="ViewPanel_Toggled" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem Text="Acciones y Controles" Tag="PlantToolsPanel" IsChecked="True" Click="ViewPanel_Toggled" />
            </MenuBarItem>
        </MenuBar>

        <Grid x:Name="DashboardContentGrid" Grid.Row="2" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PlantToolsResizeColumn" Width="8" />
                <ColumnDefinition x:Name="PlantActionColumn" Width="240" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="MainWorkspacePanel" Grid.Column="0" Padding="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid MinHeight="240">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="DesignPanel" Background="#101B2D" BorderBrush="#40516A" BorderThickness="1">
                        <Grid x:Name="DesignSurface" Background="#1A2638" AllowDrop="True" DragOver="DesignSurface_DragOver" Drop="DesignSurface_Drop">
                            <Image x:Name="TemplateImage" Stretch="Uniform" IsHitTestVisible="False" />
                            <Canvas x:Name="DesignCanvas" Background="Transparent" />

                            <StackPanel x:Name="EmptyCanvasPrompt" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="Lienzo de diseño" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Carga una imagen de la máquina como plantilla o arrástrala aquí." Foreground="#A9B8CC" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                <Button Content="Cargar imagen" Click="LoadTemplateImage_Click" HorizontalAlignment="Center" Padding="12,6" Style="{StaticResource DefaultButtonStyle}" />
                            </StackPanel>

                            <TextBlock Text="Lienzo preparado para agregar controles" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" FontSize="11" Foreground="#E6EDF7" />
                        </Grid>
                    </Border>

                    <Border x:Name="StatusPanel" Grid.Row="1" Background="#332B18" BorderBrush="#8F6C25" BorderThickness="1" Padding="10,6" CornerRadius="4" Margin="0,6,0,0">
                        <TextBlock x:Name="ModuleStatusText" Text="Panel principal de planta. Las acciones de producción requieren una integración autorizada." TextWrapping="WrapWholeWords" FontSize="12" Foreground="#FFE08A" />
                    </Border>
                </Grid>

                <Border x:Name="DashboardPanelsResizeHandle" Grid.Row="1" Height="8" Background="#26364D" CornerRadius="3" ToolTipService.ToolTip="Arrastra para cambiar la altura de los paneles inferiores." PointerPressed="DashboardPanelsResizeHandle_PointerPressed" PointerMoved="DashboardPanelsResizeHandle_PointerMoved" PointerReleased="DashboardPanelsResizeHandle_PointerReleased" PointerCaptureLost="DashboardPanelsResizeHandle_PointerCaptureLost">
                    <Border Width="52" Height="3" Background="#8293AA" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <ScrollViewer x:Name="DashboardPanelsScrollViewer" Grid.Row="2" Height="200" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="DashboardPanelsScrollViewer_SizeChanged">
                    <Grid x:Name="DashboardPanelsGrid" Width="1200" Height="200" MinWidth="1200" ColumnSpacing="12" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="250" />
                            <ColumnDefinition Width="1.35*" MinWidth="330" />
                            <ColumnDefinition Width="1.15*" MinWidth="270" />
                            <ColumnDefinition Width="1.15*" MinWidth="270" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Expander x:Name="MaterialsPanel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Header="Materiales" IsExpanded="False" Background="#172337" Foreground="#E6EDF7">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Background="#263B5A" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="75" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Material" Foreground="#F1F5F9" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="Cantidad" Foreground="#F1F5F9" FontSize="11" />
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind MaterialRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:MaterialRow">
                                            <Grid Background="#1E2D43" BorderBrush="#3B4A60" BorderThickness="0,0,0,1" Padding="6,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="75" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Nombre}" FontSize="11" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Cantidad}" FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Expander>

                        <Expander x:Name="RemissionPanel" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Header="Datos de Remisión" IsExpanded="False" Background="#172337" Foreground="#E6EDF7">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Background="#263B5A" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Título" Foreground="#F1F5F9" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="Descripción" Foreground="#F1F5F9" FontSize="11" />
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind RemissionRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:RemissionField">
                                            <Grid Background="#1E2D43" BorderBrush="#3B4A60" BorderThickness="0,0,0,1" Padding="4,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Titulo}" FontSize="10" />
                                                <TextBox Grid.Column="1" Text="{x:Bind Valor, Mode=TwoWay}" MinHeight="26" Padding="5,2" FontSize="11" Foreground="#F1F5F9" Background="#111B2B" IsEnabled="{x:Bind Editable}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Expander>

                        <Expander x:Name="HumidityPanel" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Header="Ajuste de Humedad" IsExpanded="False" Background="#172337" Foreground="#E6EDF7">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Background="#263B5A" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="45" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Agregados" Foreground="#F1F5F9" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="%" Foreground="#F1F5F9" FontSize="10" />
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind HumidityRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:PlantValue">
                                            <Grid Background="#1E2D43" BorderBrush="#3B4A60" BorderThickness="0,0,0,1" Padding="6,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="45" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Nombre}" FontSize="11" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Valor}" FontSize="11" HorizontalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Row="2" Content="Guardar" IsEnabled="False" ToolTipService.ToolTip="La persistencia real requiere integración con la planta." HorizontalAlignment="Center" FontSize="11" Style="{StaticResource DefaultButtonStyle}" />
                            </Grid>
                        </Expander>

                        <Expander x:Name="AbsorptionPanel" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Header="Ajuste de Absorción" IsExpanded="False" Background="#172337" Foreground="#E6EDF7">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Background="#263B5A" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="45" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Agregados" Foreground="#F1F5F9" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="%" Foreground="#F1F5F9" FontSize="10" />
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind AbsorptionRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:PlantValue">
                                            <Grid Background="#1E2D43" BorderBrush="#3B4A60" BorderThickness="0,0,0,1" Padding="6,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="45" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Nombre}" FontSize="11" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Valor}" FontSize="11" HorizontalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Row="2" Content="Guardar" IsEnabled="False" ToolTipService.ToolTip="La persistencia real requiere integración con la planta." HorizontalAlignment="Center" FontSize="11" Style="{StaticResource DefaultButtonStyle}" />
                            </Grid>
                        </Expander>

                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border x:Name="PlantToolsResizeHandle" Grid.Column="1" Width="8" Background="#26364D" ToolTipService.ToolTip="Arrastra para cambiar el ancho de Acciones y Controles." PointerPressed="PlantToolsResizeHandle_PointerPressed" PointerMoved="PlantToolsResizeHandle_PointerMoved" PointerReleased="PlantToolsResizeHandle_PointerReleased" PointerCaptureLost="PlantToolsResizeHandle_PointerCaptureLost">
                <Border Width="3" Height="52" Background="#8293AA" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TabView x:Name="PlantToolsPanel" Grid.Column="2" IsAddTabButtonVisible="False" CanReorderTabs="False" Background="#101B2D">
                <TabViewItem Header="Acciones" IsClosable="False">
                    <StackPanel Padding="8" Spacing="8">
                        <Button Content="PROGRAMAR" IsEnabled="False" ToolTipService.ToolTip="Requiere conexión autorizada al controlador de la planta." Style="{StaticResource DefaultButtonStyle}" />
                        <Button Content="CARGAR" IsEnabled="False" ToolTipService.ToolTip="Requiere conexión autorizada al controlador de la planta." Style="{StaticResource DefaultButtonStyle}" />
                        <Button Content="DESCARGAR" IsEnabled="False" ToolTipService.ToolTip="Requiere conexión autorizada al controlador de la planta." Style="{StaticResource DefaultButtonStyle}" />
                        <Button Content="PAUSAR" IsEnabled="False" ToolTipService.ToolTip="Requiere conexión autorizada al controlador de la planta." Style="{StaticResource DefaultButtonStyle}" />
                        <Button Content="CANCELAR" IsEnabled="False" ToolTipService.ToolTip="Requiere conexión autorizada al controlador de la planta." Style="{StaticResource DefaultButtonStyle}" />
                    </StackPanel>
                </TabViewItem>
                <TabViewItem Header="Controles" IsClosable="False">
                    <Grid Padding="12">
                        <TextBlock Text="Los controles disponibles se definirán más adelante." Foreground="#A9B8CC" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                    </Grid>
                </TabViewItem>
            </TabView>
        </Grid>

        <Grid Grid.Row="3" Background="#111C2D" Padding="8,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CurrentUserText" Text="USUARIO:" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="CurrentRoleText" Grid.Column="1" Text="TIPO:" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="SystemStatusText" Grid.Column="2" Text="Sin conexión con PLC ni base de datos" Foreground="#FBBF24" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock x:Name="ClockText" Grid.Column="3" FontSize="10" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="InventoryFormOverlay" Grid.RowSpan="4" Background="#99000000" Visibility="Collapsed">
            <Border MaxWidth="1200" MaxHeight="900" Margin="8" Background="#111C2D" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Background="#0078D4" CornerRadius="7,7,0,0" Padding="12,2">
                        <TextBlock Text="Inventario" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                        <Button Content="×" Click="CloseInventoryForm_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="28" Padding="0" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" ToolTipService.ToolTip="Cerrar Inventario" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#172337" Padding="8,5" Spacing="8">
                        <Button x:Name="InventorySaveButton" Content="Guardar" Click="SaveInventory_Click" IsEnabled="False" Style="{StaticResource DefaultButtonStyle}" />
                        <CheckBox x:Name="InventoryEntriesCheckBox" Content="Entradas" Foreground="#E6EDF7" Checked="InventoryOperation_Changed" Unchecked="InventoryOperation_Changed" VerticalAlignment="Center" Visibility="Collapsed" />
                        <CheckBox x:Name="InventoryExitsCheckBox" Content="Salidas" Foreground="#E6EDF7" Checked="InventoryOperation_Changed" Unchecked="InventoryOperation_Changed" VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>

                    <Border Grid.Row="2" Background="#172337" BorderBrush="#40516A" BorderThickness="0,0,0,1" Padding="10,5">
                        <TextBlock Text="Inventario de Materiales" Foreground="#F1F5F9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>

                    <Grid Grid.Row="3" Padding="10" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#172337" BorderBrush="#40516A" BorderThickness="1" Padding="8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Existencias actuales en BlapaciSQL" Foreground="#E6EDF7" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                                            <TextBlock Text="AGREGADOS" Foreground="#F1F5F9" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <Grid Background="#263B5A" Padding="5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Nombre" Foreground="#F1F5F9" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="Existencia" Foreground="#F1F5F9" FontWeight="SemiBold" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{x:Bind AggregateInventory}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="services:InventoryMaterial">
                                                        <Grid Background="#1E2D43" Padding="5">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind Name}" Foreground="#E6EDF7" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" Foreground="#E6EDF7" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                                            <TextBlock Text="ADITIVOS" Foreground="#F1F5F9" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <Grid Background="#263B5A" Padding="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Nombre" Foreground="#F1F5F9" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Existencia" Foreground="#F1F5F9" FontWeight="SemiBold" /></Grid>
                                            <ItemsControl ItemsSource="{x:Bind AdditiveInventory}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="services:InventoryMaterial">
                                                        <Grid Background="#1E2D43" Padding="5">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind Name}" Foreground="#E6EDF7" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" Foreground="#E6EDF7" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="5">
                                            <TextBlock Text="FIBRAS" Foreground="#F1F5F9" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <Grid Background="#263B5A" Padding="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Nombre" Foreground="#F1F5F9" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Existencia" Foreground="#F1F5F9" FontWeight="SemiBold" /></Grid>
                                            <ItemsControl ItemsSource="{x:Bind FiberInventory}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="services:InventoryMaterial">
                                                        <Grid Background="#1E2D43" Padding="5">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind Name}" Foreground="#E6EDF7" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" Foreground="#E6EDF7" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                                            <TextBlock Text="AGUAS" Foreground="#F1F5F9" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <Grid Background="#263B5A" Padding="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Nombre" Foreground="#F1F5F9" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Existencia" Foreground="#F1F5F9" FontWeight="SemiBold" /></Grid>
