<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Master_WinUI.SecurityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource Palette111C2D}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource Palette0078D4}" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="Seguridad"
                    Foreground="{ThemeResource PaletteF1F5F9}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="1"
                    Click="Close_Click"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{ThemeResource PaletteF1F5F9}"
                    ToolTipService.ToolTip="Cerrar"
                    AutomationProperties.Name="Cerrar">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
            </Grid>
        </Border>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="6"
            Padding="8,6"
            Background="{ThemeResource Palette172337}">
            <Button
                x:Name="AddUserButton"
                Click="AddUser_Click"
                Background="{ThemeResource Palette26364D}"
                Foreground="{ThemeResource PaletteF1F5F9}"
                BorderBrush="{ThemeResource Palette40516A}"
                ToolTipService.ToolTip="Los accesos del nuevo usuario se asignan en Configuración, Accesos.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Agregar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                x:Name="EditUserButton"
                Click="EditUser_Click"
                Background="{ThemeResource Palette26364D}"
                Foreground="{ThemeResource PaletteF1F5F9}"
                BorderBrush="{ThemeResource Palette40516A}"
                ToolTipService.ToolTip="Editar usuarios requiere una operación de seguridad autorizada.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Edit" />
                    <TextBlock Text="Editar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                x:Name="DeleteUserButton"
                Click="DeleteUser_Click"
                Background="{ThemeResource Palette26364D}"
                Foreground="{ThemeResource PaletteF1F5F9}"
                BorderBrush="{ThemeResource Palette40516A}"
                ToolTipService.ToolTip="Borrar usuarios requiere una operación de seguridad autorizada.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Delete" />
                    <TextBlock Text="Borrar" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="2"
            IsOpen="False"
            IsClosable="True" />

        <Grid Grid.Row="3" Padding="16" Background="{ThemeResource Palette111C2D}">
            <Border
                BorderBrush="{ThemeResource Palette40516A}"
                BorderThickness="1"
                Padding="12"
                Background="{ThemeResource Palette172337}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="Usuarios"
                        Foreground="{ThemeResource PaletteE6EDF7}"
                        FontWeight="SemiBold" />
                    <ListView
                        x:Name="UsersListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind SystemUsers, Mode=OneWay}"
                        DisplayMemberPath="Username"
                        SelectionMode="Single"
                        SelectionChanged="UsersListView_SelectionChanged"
                        Background="{ThemeResource Palette111C2D}"
                        Foreground="{ThemeResource PaletteF1F5F9}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
