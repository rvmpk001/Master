<Window
    x:Class="Master.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinForms Control Showcase - Login">
    <ScrollViewer
        x:Name="MainScrollViewer"
        AutomationProperties.AutomationId="mainScrollViewer"
        Background="#FF171A21"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="16,20,16,24" RowDefinitions="Auto,Auto" RowSpacing="20">
            <Grid
                x:Name="pnlHeader"
                Grid.Row="0"
                MaxWidth="560"
                AutomationProperties.AutomationId="pnlHeader"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="16"
                HorizontalAlignment="Center">
                <Border
                    x:Name="picLogo"
                    Grid.Column="0"
                    Width="64"
                    Height="64"
                    AutomationProperties.AutomationId="picLogo"
                    Background="#FF24364A"
                    BorderBrush="#FF3A5878"
                    BorderThickness="1"
                    CornerRadius="12">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#FF62B5F2"
                        Text="WCS" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Spacing="4"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="lblTitulo"
                        AutomationProperties.AutomationId="lblTitulo"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="#FFF2F4F7"
                        Text="Inicio de Sesión"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="lblSubtitulo"
                        AutomationProperties.AutomationId="lblSubtitulo"
                        FontSize="13"
                        Foreground="#FFB7C0CC"
                        Text="Showcase Corporativo de Controles WinForms"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border
                x:Name="pnlCard"
                Grid.Row="1"
                MaxWidth="560"
                AutomationProperties.AutomationId="pnlCard"
                AutomationProperties.Name="Showcase Corporativo de Controles WinForms"
                Background="#FF252A33"
                BorderBrush="#FF3B434F"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Center">
                <StackPanel Padding="24" Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="lblUsuario"
                            AutomationProperties.AutomationId="lblUsuario"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#FFE8ECF2"
                            Text="Usuario" />
                        <TextBox
                            x:Name="txtUsuario"
                            MaxLength="50"
                            MinWidth="0"
                            AutomationProperties.AutomationId="txtUsuario"
                            AutomationProperties.Name="Usuario"
                            LostFocus="OnUsernameLostFocus"
                            Background="#FF1C2129"
                            BorderBrush="#FF596574"
                            BorderThickness="1"
                            CharacterCasing="Normal"
                            FontSize="15"
                            Foreground="#FFF2F4F7"
                            PlaceholderText="Escribe tu usuario" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="lblPassword"
                            AutomationProperties.AutomationId="lblPassword"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#FFE8ECF2"
                            Text="Contraseña" />
                        <Grid>
                            <PasswordBox
                                x:Name="txtPassword"
                                AutomationProperties.AutomationId="txtPassword"
                                AutomationProperties.Name="Contraseña"
                                Background="#FF1C2129"
                                BorderBrush="#FF596574"
                                BorderThickness="1"
                                FontSize="15"
                                Foreground="#FFF2F4F7"
                                PlaceholderText="Escribe tu contraseña" />
                            <TextBox
                                x:Name="txtPasswordVisible"
                                Visibility="Collapsed"
                                AutomationProperties.AutomationId="txtPasswordVisible"
                                AutomationProperties.Name="Contraseña visible"
                                Background="#FF1C2129"
                                BorderBrush="#FF596574"
                                BorderThickness="1"
                                FontSize="15"
                                Foreground="#FFF2F4F7"
                                PlaceholderText="Escribe tu contraseña" />
                        </Grid>
                        <CheckBox
                            x:Name="chkVerPassword"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="chkVerPassword"
                            Content="Mostrar contraseña"
                            FontSize="13"
                            Foreground="#FFE8ECF2"
                            Checked="OnPasswordVisibilityChanged"
                            Unchecked="OnPasswordVisibilityChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="lblPin"
                            AutomationProperties.AutomationId="lblPin"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#FFE8ECF2"
                            Text="PIN de Seguridad (2FA)" />
                        <TextBox
                            x:Name="mtxtPin"
                            MinWidth="0"
                            AutomationProperties.AutomationId="mtxtPin"
                            AutomationProperties.Name="PIN de Seguridad (2FA)"
                            Background="#FF1C2129"
                            BorderBrush="#FF596574"
                            BorderThickness="1"
                            FontSize="15"
                            Foreground="#FFF2F4F7"
                            PlaceholderText="PIN (si corresponde)" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <CheckBox
                            x:Name="chkRecordar"
                            AutomationProperties.AutomationId="chkRecordar"
                            Content="Recordar usuario"
                            FontSize="13"
                            Foreground="#FFE8ECF2"
                            Checked="OnRememberUserChanged"
                            Unchecked="OnRememberUserChanged" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#FFB7C0CC"
                            Margin="32,0,0,0"
                            Text="Guarda únicamente el usuario en este equipo; la contraseña nunca se almacena."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button
                            x:Name="btnIngresar"
                            Grid.Column="0"
                            AutomationProperties.AutomationId="btnIngresar"
                            Background="#FF1678BC"
                            Content="Ingresar al Sistema"
                            FontSize="14"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            Click="OnLoginClick" />
                        <Button
                            x:Name="btnCancelar"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="btnCancelar"
                            Background="#FF353C47"
                            BorderBrush="#FF596574"
                            Content="Cancelar"
                            FontSize="14"
                            Foreground="#FFE8ECF2"
                            HorizontalAlignment="Stretch"
                            Click="OnCancelClick" />
                    </Grid>

                    <InfoBar
                        x:Name="formStatus"
                        IsClosable="True"
                        IsOpen="False"
                        AutomationProperties.AutomationId="formStatus"
                        Message=""
                        Title="" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
