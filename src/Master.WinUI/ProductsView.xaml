<UserControl
    x:Class="Master.WinUI.ProductsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="RootLayout"
        Background="#FF171A21"
        Padding="20"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.AutomationId="lblTituloProductos"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="#FFF2F4F7"
                    Text="Catálogo de Productos"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="14"
                    Foreground="#FFB7C0CC"
                    Text="Control de catálogo, stock de inventario, precios y galería fotográfica."
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Name="btnVolverDashboard"
                Grid.Column="1"
                AutomationProperties.AutomationId="btnVolverDashboardProductos"
                Content="Volver al Dashboard"
                Click="OnBackToDashboardClick"
                VerticalAlignment="Center" />
        </Grid>

        <Grid
            x:Name="FilterBar"
            Grid.Row="1"
            ColumnDefinitions="2*,1.4*,Auto,Auto"
            ColumnSpacing="8"
            RowDefinitions="Auto">
            <TextBox
                x:Name="txtBuscar"
                AutomationProperties.AutomationId="txtBuscarProductos"
                AutomationProperties.Name="Buscar productos"
                PlaceholderText="Buscar código, nombre o descripción"
                VerticalAlignment="Center" />
            <ComboBox
                x:Name="cmbFiltroCategoria"
                Grid.Column="1"
                AutomationProperties.AutomationId="cmbFiltroCategoriaProductos"
                AutomationProperties.Name="Filtrar por categoría"
                DisplayMemberPath="Name"
                VerticalAlignment="Center" />
            <Button
                x:Name="btnBuscar"
                Grid.Column="2"
                AutomationProperties.AutomationId="btnBuscarProductos"
                Content="Filtrar"
                Click="OnFilterClick"
                VerticalAlignment="Center" />
            <Button
                x:Name="btnLimpiarFiltro"
                Grid.Column="3"
                AutomationProperties.AutomationId="btnLimpiarFiltroProductos"
                Content="Todos"
                Click="OnClearFilterClick"
                VerticalAlignment="Center" />
        </Grid>

        <Grid
            x:Name="ContentLayout"
            Grid.Row="2"
            ColumnDefinitions="1.2*,1*"
            ColumnSpacing="16"
            RowDefinitions="*,*"
            RowSpacing="16"
            SizeChanged="OnContentSizeChanged">
            <Border
                x:Name="pnlListaProductos"
                AutomationProperties.AutomationId="pnlListaProductos"
                Background="#FF252A33"
                BorderBrush="#FF3B434F"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#FFF2F4F7"
                            Text="Productos" />
                        <TextBlock
                            x:Name="lblConteo"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="lblConteoProductos"
                            Foreground="#FFB7C0CC"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="52,1.2*,1.8*,1.4*,Auto,Auto"
                        ColumnSpacing="8">
                        <TextBlock Foreground="#FFB7C0CC" Text="ID" />
                        <TextBlock Grid.Column="1" Foreground="#FFB7C0CC" Text="Código" />
                        <TextBlock Grid.Column="2" Foreground="#FFB7C0CC" Text="Nombre" />
                        <TextBlock Grid.Column="3" Foreground="#FFB7C0CC" Text="Categoría" />
                        <TextBlock Grid.Column="4" Foreground="#FFB7C0CC" Text="Precio" />
                        <TextBlock Grid.Column="5" Foreground="#FFB7C0CC" Text="Stock" />
                    </Grid>
                    <ListView
                        x:Name="lstProductos"
                        Grid.Row="2"
                        AutomationProperties.AutomationId="dgvProductos"
                        AutomationProperties.Name="Productos"
                        ScrollViewer.IsVerticalScrollChainingEnabled="False"
                        ScrollViewer.VerticalScrollMode="Enabled"
                        SelectionChanged="OnProductSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    ColumnDefinitions="52,1.2*,1.8*,1.4*,Auto,Auto"
                                    ColumnSpacing="8"
                                    Padding="0,6">
                                    <TextBlock
                                        Text="{Binding Id}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Code}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding CategoryName}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{Binding UnitPrice, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{Binding Stock}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                x:Name="pnlFormulario"
                Grid.Column="1"
                AutomationProperties.AutomationId="gbFormularioProductos"
                Background="#FF252A33"
                BorderBrush="#FF3B434F"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
                <ScrollViewer
                    AutomationProperties.AutomationId="productFormScrollViewer"
                    IsVerticalScrollChainingEnabled="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#FFF2F4F7"
                            Text="Detalles del Producto" />

                        <StackPanel Spacing="4">
                            <TextBlock Foreground="#FFE8ECF2" Text="Código *" />
                            <TextBox
                                x:Name="txtCodigo"
                                MaxLength="50"
                                AutomationProperties.AutomationId="txtCodigo" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Foreground="#FFE8ECF2" Text="Nombre del Producto *" />
                            <TextBox
                                x:Name="txtNombre"
                                MaxLength="150"
                                AutomationProperties.AutomationId="txtNombre" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Foreground="#FFE8ECF2" Text="Categoría *" />
                            <ComboBox
                                x:Name="cmbCategoria"
                                AutomationProperties.AutomationId="cmbCategoria"
                                AutomationProperties.Name="Categoría del producto"
                                DisplayMemberPath="Name" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="#FFE8ECF2" Text="Precio Unitario" />
                                <NumberBox
                                    x:Name="nudPrecio"
                                    AutomationProperties.AutomationId="nudPrecio"
                                    IsWrapEnabled="False"
                                    Minimum="0"
                                    SmallChange="0.01"
                                    SpinButtonPlacementMode="Inline"
                                    Value="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Foreground="#FFE8ECF2" Text="Stock Disponible" />
                                <NumberBox
                                    x:Name="nudStock"
                                    AutomationProperties.AutomationId="nudStock"
                                    IsWrapEnabled="False"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Foreground="#FFE8ECF2" Text="Descripción" />
                            <TextBox
                                x:Name="txtDescripcion"
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="txtDescripcion"
                                MaxLength="500"
                                MinHeight="72"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <CheckBox
                            x:Name="chkActivo"
                            AutomationProperties.AutomationId="chkActivo"
                            Content="Producto Activo"
                            IsChecked="True" />

                        <Border
                            Background="#FF1C2129"
                            BorderBrush="#FF3B434F"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Grid RowDefinitions="*,Auto">
                                    <Image
                                        x:Name="imgProducto"
                                        AutomationProperties.AutomationId="picProducto"
                                        MaxHeight="180"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        x:Name="lblImagen"
                                        Grid.Row="1"
                                        AutomationProperties.AutomationId="lblImagenProducto"
                                        Foreground="#FFB7C0CC"
                                        Text="Sin imagen seleccionada."
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <Button
                                        x:Name="btnCargarImagen"
                                        AutomationProperties.AutomationId="btnCargarImagen"
                                        Content="Cargar Foto..."
                                        Click="OnLoadImageClick" />
                                    <Button
                                        x:Name="btnQuitarImagen"
                                        AutomationProperties.AutomationId="btnQuitarImagen"
                                        Content="Quitar Foto"
                                        Click="OnRemoveImageClick" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Button
                                x:Name="btnNuevo"
                                AutomationProperties.AutomationId="btnNuevo"
                                Content="Nuevo"
                                Click="OnNewClick" />
                            <Button
                                x:Name="btnGuardar"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="btnGuardar"
                                Content="Guardar"
                                Click="OnSaveClick" />
                            <Button
                                x:Name="btnEliminar"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="btnEliminar"
                                Content="Eliminar"
                                Click="OnDeleteClick" />
                            <Button
                                x:Name="btnCancelar"
                                Grid.Column="3"
                                AutomationProperties.AutomationId="btnCancelar"
                                Content="Cancelar"
                                Click="OnCancelClick" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <InfoBar
            x:Name="productStatus"
            Grid.Row="3"
            AutomationProperties.AutomationId="productStatus"
            IsClosable="True"
            IsOpen="False"
            Message=""
            Severity="Informational"
            Title="" />
    </Grid>
</UserControl>
